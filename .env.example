# AgentForge AI Configuration Environment Variables Template

APP_ENV=development
LOG_LEVEL=INFO

# Google Gemini / Vertex AI API Keys
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini

# PostgreSQL / Supabase Database Connection URLs
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/postgres
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/postgres

# Security & JWT Authentication
# Generate secure JWT secret in PowerShell / Terminal:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-secret-key-change-in-production-min-64-bytes-long-secure-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=*
MAX_REQUEST_SIZE=10485760

# Third-Party Search Tools (Optional)
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
